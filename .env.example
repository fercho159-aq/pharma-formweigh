# =============================================================================
# PharmaWeigh — contrato de variables de entorno
# Copia a .env.local (desarrollo) o a /opt/pharmaweigh/.env (VPS, root, chmod 600).
# Cero secretos reales en git: este archivo solo trae ejemplos y valores vacíos.
# =============================================================================

# --- Base de datos (Postgres 16) ---------------------------------------------
# Dev: tu Postgres local. VPS: el compose la arma sola apuntando al contenedor `db`
# como postgres://pharma:$POSTGRES_PASSWORD@db:5432/pharmaweigh, así que en el .env
# del VPS esta línea es informativa y lo que manda es POSTGRES_PASSWORD.
DATABASE_URL=postgres://pharma:pharma@localhost:5432/pharmaweigh

# Contraseña del usuario `pharma` de Postgres. SOLO la usa docker-compose.
# Generar con: openssl rand -base64 32
# Ojo: si la cambias después del primer arranque, el volumen `pgdata` conserva la
# contraseña vieja; hay que cambiarla también con ALTER ROLE dentro de psql.
POSTGRES_PASSWORD=

# --- Sitio -------------------------------------------------------------------
# URL canónica pública. Nunca se deriva del header Host.
# Dev: http://localhost:3000 · VPS: https://pharmaweigh.appsoluciones.duckdns.org
# Se hornea en el bundle durante `next build` (es NEXT_PUBLIC_*), no en runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Puerto publicado en el host del VPS -------------------------------------
# 127.0.0.1:APP_PORT -> 3000 del contenedor. 3062 asignado a PharmaWeigh
# (3060 = Club Mini Precios, 3061 = Treca). No reutilizar.
APP_PORT=3062

# --- Zona horaria del proceso ------------------------------------------------
# Manda en los sellos de tiempo de dispensado, pesaje y firmas.
TZ=America/Mexico_City

# =============================================================================
# Lo que PharmaWeigh NO usa (para que nadie lo busque):
#   - No hay secreto de sesión: las sesiones son opacas y viven en la BD.
#   - No hay cron por HTTP: el único cron del host es el respaldo (pg_dump).
#   - No hay carga de archivos ni volumen de uploads.
#   - No hay SMTP ni pasarela de pagos.
# =============================================================================
