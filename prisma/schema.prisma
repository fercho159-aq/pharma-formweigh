generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("OPERARIO") // ADMIN, SUPERVISOR, OPERARIO
  badge     String?  @unique // código de barras del badge
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  auditorias  Auditoria[]
  dispensados Dispensado[]
}

model Material {
  id          String  @id @default(cuid())
  codigo      String  @unique // código de barras
  nombre      String
  descripcion String?
  unidad      String // kg, g, L, mL
  stockMinimo Float
  activo      Boolean @default(true)

  lotes        Lote[]
  ingredientes Ingrediente[]
}

model Lote {
  id              String   @id @default(cuid())
  numero          String   @unique // número de lote (código de barras)
  materialId      String
  material        Material @relation(fields: [materialId], references: [id])
  cantidad        Float // cantidad actual
  cantidadInicial Float
  fechaRecepcion  DateTime
  fechaCaducidad  DateTime
  proveedor       String
  estado          String   @default("CUARENTENA") // CUARENTENA, APROBADO, RECHAZADO, AGOTADO, CADUCADO
  certificado     String? // referencia al certificado de análisis
  createdAt       DateTime @default(now())

  dispensados Dispensado[]
}

model Receta {
  id                String   @id @default(cuid())
  codigo            String   @unique
  nombre            String
  version           Int      @default(1)
  descripcion       String?
  rendimiento       Float // cantidad que produce
  unidadRendimiento String
  activa            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ingredientes Ingrediente[]
  ordenes      OrdenProduccion[]
}

model Ingrediente {
  id            String  @id @default(cuid())
  recetaId      String
  receta        Receta  @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material @relation(fields: [materialId], references: [id])
  orden         Int // orden de dispensado
  cantidadTarget Float // cantidad objetivo
  toleranciaMin Float // % tolerancia mínima (ej: -2)
  toleranciaMax Float // % tolerancia máxima (ej: +2)
  instrucciones String?
  peligroso     Boolean @default(false)
}

model OrdenProduccion {
  id           String   @id @default(cuid())
  numero       String   @unique
  recetaId     String
  receta       Receta   @relation(fields: [recetaId], references: [id])
  loteProducto String // lote del producto final
  cantidad     Float // multiplicador vs receta
  estado       String   @default("PENDIENTE") // PENDIENTE, EN_PROCESO, DISPENSADO, EN_PRODUCCION, COMPLETADA, CANCELADA
  prioridad    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dispensados Dispensado[]
}

model Dispensado {
  id               String   @id @default(cuid())
  ordenId          String
  orden            OrdenProduccion @relation(fields: [ordenId], references: [id])
  loteId           String
  lote             Lote     @relation(fields: [loteId], references: [id])
  operarioId       String
  operario         Usuario  @relation(fields: [operarioId], references: [id])
  materialNombre   String
  cantidadTarget   Float
  cantidadReal     Float
  toleranciaOk     Boolean
  paso             Int
  firmaElectronica String? // supervisor password hash for approval
  supervisorId     String?
  timestamp        DateTime @default(now())
}

model Auditoria {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  accion    String // LOGIN, CREAR_RECETA, DISPENSAR, APROBAR_LOTE, etc.
  entidad   String // tabla afectada
  entidadId String // ID del registro
  detalles  String // JSON snapshot del cambio
  ip        String?
  timestamp DateTime @default(now())
}
