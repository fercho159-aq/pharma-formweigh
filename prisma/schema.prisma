// use prisma-next

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("OPERARIO")
  badge     String?  @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  auditorias  Auditoria[]
  dispensados Dispensado[]
}

model Material {
  id          String  @id @default(uuid())
  codigo      String  @unique
  nombre      String
  descripcion String?
  unidad      String
  stockMinimo Float
  activo      Boolean @default(true)

  lotes        Lote[]
  ingredientes Ingrediente[]
}

model Lote {
  id              String   @id @default(uuid())
  numero          String   @unique
  materialId      String
  material        Material @relation(fields: [materialId], references: [id])
  cantidad        Float
  cantidadInicial Float
  fechaRecepcion  DateTime
  fechaCaducidad  DateTime
  proveedor       String
  estado          String   @default("CUARENTENA")
  certificado     String?
  createdAt       DateTime @default(now())

  dispensados Dispensado[]
}

model Receta {
  id                String   @id @default(uuid())
  codigo            String   @unique
  nombre            String
  version           Int      @default(1)
  descripcion       String?
  rendimiento       Float
  unidadRendimiento String
  activa            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  ingredientes Ingrediente[]
  ordenes      OrdenProduccion[]
}

model Ingrediente {
  id            String   @id @default(uuid())
  recetaId      String
  receta        Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material @relation(fields: [materialId], references: [id])
  orden         Int
  cantidadTarget Float
  toleranciaMin Float
  toleranciaMax Float
  instrucciones String?
  peligroso     Boolean @default(false)
}

model OrdenProduccion {
  id           String   @id @default(uuid())
  numero       String   @unique
  recetaId     String
  receta       Receta   @relation(fields: [recetaId], references: [id])
  loteProducto String
  cantidad     Float
  estado       String   @default("PENDIENTE")
  prioridad    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  dispensados Dispensado[]
}

model Dispensado {
  id               String   @id @default(uuid())
  ordenId          String
  orden            OrdenProduccion @relation(fields: [ordenId], references: [id])
  loteId           String
  lote             Lote     @relation(fields: [loteId], references: [id])
  operarioId       String
  operario         Usuario  @relation(fields: [operarioId], references: [id])
  materialNombre   String
  cantidadTarget   Float
  cantidadReal     Float
  toleranciaOk     Boolean
  paso             Int
  firmaElectronica String?
  supervisorId     String?
  timestamp        DateTime @default(now())
}

model Auditoria {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  accion    String
  entidad   String
  entidadId String
  detalles  String
  ip        String?
  timestamp DateTime @default(now())
}
